POSTGRES_DB=dataops
POSTGRES_USER=dataops_dev
POSTGRES_PASSWORD=replace_with_a_random_local_password
POSTGRES_PORT=5432

# Generate unique local secrets before enabling the airflow profile.
AIRFLOW_META_PASSWORD=replace_with_a_random_hex_password
AIRFLOW_JWT_SECRET=replace_with_a_random_secret
AIRFLOW_API_SECRET=replace_with_a_random_secret
AIRFLOW_FERNET_KEY=replace_with_a_fernet_key
FAILURE_EMAIL_FROM=airflow@example.invalid
FAILURE_EMAIL_TO=developer@example.invalid
AIRFLOW_API_URL=http://127.0.0.1:8080
AIRFLOW_API_USERNAME=pipeline_viewer
AIRFLOW_API_PASSWORD=replace_with_viewer_password

# Local OpenAI configuration. Store the actual API key only in .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
